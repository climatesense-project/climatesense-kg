PREFIX schema: <http://schema.org/>
PREFIX cimple: <http://data.cimple.eu/ontology#>
PREFIX cs: <http://data.climatesense-project.eu/ontology#>

SELECT (COUNT(DISTINCT ?claim) AS ?totalClaims)
       (COUNT(DISTINCT ?claimWithEmotion) AS ?claimsWithEmotion)
       (COUNT(DISTINCT ?claimWithSentiment) AS ?claimsWithSentiment)
       (COUNT(DISTINCT ?claimWithLeaning) AS ?claimsWithPoliticalLeaning)
       (COUNT(DISTINCT ?claimWithConspiracy) AS ?claimsWithConspiracy)
       (COUNT(DISTINCT ?claimWithTrope) AS ?claimsWithTropes)
       (COUNT(DISTINCT ?claimWithPersuasion) AS ?claimsWithPersuasionTechniques)
       (COUNT(DISTINCT ?claimWithClimateRelatedness) AS ?claimsWithClimateRelatedness)
WHERE {
  ?claim a schema:Claim .
  OPTIONAL {
    ?claim cimple:hasEmotion ?emotion .
    BIND(?claim AS ?claimWithEmotion)
  }
  OPTIONAL {
    ?claim cimple:hasSentiment ?sentiment .
    BIND(?claim AS ?claimWithSentiment)
  }
  OPTIONAL {
    ?claim cimple:hasPoliticalLeaning ?leaning .
    BIND(?claim AS ?claimWithLeaning)
  }
  OPTIONAL {
    ?claim cimple:mentionsConspiracy ?conspiracy .
    BIND(?claim AS ?claimWithConspiracy)
  }
  OPTIONAL {
    ?claim cimple:hasTrope ?trope .
    BIND(?claim AS ?claimWithTrope)
  }
  OPTIONAL {
    ?claim cimple:hasPersuasionTechnique ?persuasionTechnique .
    BIND(?claim AS ?claimWithPersuasion)
  }
  OPTIONAL {
    ?claim cs:isClimateRelated ?climateRelated .
    BIND(?claim AS ?claimWithClimateRelatedness)
  }
}
