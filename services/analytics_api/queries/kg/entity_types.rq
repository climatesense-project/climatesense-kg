PREFIX schema: <http://schema.org/>
PREFIX graph: <http://data.climatesense-project.eu/graph/>

SELECT ?entity (COUNT(?entity) AS ?count)
WHERE {
  {
    SELECT DISTINCT ?claim ?rdfType
    WHERE {
      GRAPH ?sourceGraph {
        ?claim a ?rdfType .
      }
      VALUES ?rdfType { schema:Claim schema:ClaimReview }
    }
  }
  VALUES ?enricherGraph { graph:dbpedia-enricher graph:wikidata-enricher }
  GRAPH ?enricherGraph {
    ?claim schema:mentions ?entity .
  }
}
GROUP BY ?entity
ORDER BY DESC(?count)
LIMIT 25
