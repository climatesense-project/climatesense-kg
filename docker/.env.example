# ============================================================
# ClimateSense KG - Docker environment
# ============================================================
# Copy this file to docker/.env and adjust the values:
#
#   cp docker/.env.example docker/.env
# ============================================================

# ------------------------------------------------------------
# General
# ------------------------------------------------------------

# The triplestore is chosen by which compose file you load:
# docker-compose.virtuoso.yml or docker-compose.qlever.yml.

# GitHub token used to fetch private source repositories. Leave blank
# unless you ingest private data sources.
GITHUB_TOKEN=

# ------------------------------------------------------------
# Virtuoso triplestore
# ------------------------------------------------------------

# Hostname of the Virtuoso container on the compose network.
VIRTUOSO_HOST=virtuoso

# Host interface on which the Virtuoso HTTP/SPARQL endpoint is
# published.
VIRTUOSO_BIND_ADDRESS=127.0.0.1

# Published port for the Virtuoso HTTP/SPARQL endpoint.
VIRTUOSO_PORT=8890

# Virtuoso database user used for deployment and administrative
# operations.
VIRTUOSO_USER=dba

# Virtuoso database password. Passed to the container as DBA_PASSWORD
# on first startup.
VIRTUOSO_PASSWORD=

# ------------------------------------------------------------
# QLever triplestore
# ------------------------------------------------------------

# Internal SPARQL endpoint of the QLever engine, used by the
# analytics services on the compose network.
QLEVER_ENDPOINT=http://qlever:7019

# Published port for the QLever SPARQL endpoint.
QLEVER_PORT=7019

# Token required for QLever administrative operations (index
# loading, cache clearing). Generate a long random value with
# `openssl rand -hex 32`.
QLEVER_ACCESS_TOKEN=replace_with_a_long_random_token

# Memory available to index builds during just qlever-deploy.
QLEVER_INDEX_MEMORY=1G

# Memory available to queries at runtime.
QLEVER_MEMORY_FOR_QUERIES=5G

# Maximum size of the QLever query-result cache.
QLEVER_CACHE_MAX_SIZE=2G

# Default timeout for queries run against QLever.
QLEVER_QUERY_TIMEOUT=30s

# UID that owns the persistent QLever index volume.
QLEVER_UID=999

# GID that owns the persistent QLever index volume.
QLEVER_GID=999

# ------------------------------------------------------------
# RDF Workbench
# ------------------------------------------------------------
# Next.js UI for exploring and managing the selected triplestore.
# It is part of the stack and starts with either overlay.

# The triplestore provider is chosen by the compose overlay you
# load. You only need to set this explicitly when running the
# workbench against a remote endpoint without an overlay.
TRIPLESTORE_PROVIDER=

# SPARQL endpoint of the selected triplestore. The overlays default
# to the internal qlever/virtuoso endpoints; set it explicitly only
# to target a remote triplestore.
# SPARQL_ENDPOINT=http://qlever:7019

# Published port for the workbench. Defaults to 3001 because the
# analytics UI already occupies 3000.
WORKBENCH_PORT=3001

# Browser-visible origin of the workbench, used for redirects and
# mutation origin checks.
WORKBENCH_URL=http://localhost:3001

# Display name shown in the workbench UI.
WORKBENCH_NAME=RDF Workbench

# Base of dereferenceable resource IRIs. When set, /resource/<id>
# resolves to <RESOURCE_BASE_URI>/resource/<id>.
RESOURCE_BASE_URI=

# QLever provider: bootstrap administrator created when the local
# user database is empty.
BOOTSTRAP_ADMIN_USERNAME=admin

# QLever provider: bootstrap administrator password. Use a value of
# at least 12 characters.
BOOTSTRAP_ADMIN_PASSWORD=replace_with_a_long_secret

# Virtuoso provider: session signing secret. At least 32
# characters. Generate with `openssl rand -hex 32`.
SESSION_SECRET=replace_with_a_long_random_secret

# Virtuoso provider: shared token between the workbench frontend and
# the virtuoso-adapter. At least 32 characters. Generate with
# `openssl rand -hex 32`.
VIRTUOSO_ADAPTER_TOKEN=replace_with_a_long_random_secret

# ------------------------------------------------------------
# CIMPLE Factors API
# ------------------------------------------------------------

# Base URL of the CIMPLE Factors API used for text enrichment.
CIMPLE_FACTORS_API_URL=

# ------------------------------------------------------------
# Pipeline user
# ------------------------------------------------------------
# UID/GID of the user that runs inside the pipeline container, so
# files it writes to bind-mounted volumes (data/, logs/, cache/)
# are owned by the expected host user.

# Host UID used for pipeline-generated files.
PIPELINE_UID=1000

# Host GID used for pipeline-generated files.
PIPELINE_GID=1000

# ------------------------------------------------------------
# PostgreSQL Database
# ------------------------------------------------------------

# Hostname of the PostgreSQL container on the compose network.
POSTGRES_HOST=postgres

# Host interface on which PostgreSQL is published. Keep at
# 127.0.0.1 to avoid exposing the database on the network.
POSTGRES_BIND_ADDRESS=127.0.0.1

# Published port for PostgreSQL.
POSTGRES_HOST_PORT=5432

# Database name.
POSTGRES_DB=climatesense

# Database user.
POSTGRES_USER=postgres

# Database password.
POSTGRES_PASSWORD=

# ------------------------------------------------------------
# Analytics API
# ------------------------------------------------------------

# Optional asyncpg DSN for the analytics API. When omitted, the API
# builds the DSN from the POSTGRES_* variables above.
# ANALYTICS_DATABASE_DSN=postgresql+asyncpg://postgres:postgres@postgres:5432/climatesense

# SPARQL endpoint the analytics API queries.
# For Virtuoso, use http://virtuoso:8890/sparql
# For QLever, use http://qlever:7019
# ANALYTICS_SPARQL_ENDPOINT=http://virtuoso:8890/sparql
ANALYTICS_SPARQL_ENDPOINT=http://qlever:7019

# Optional username for the analytics SPARQL endpoint.
# ANALYTICS_SPARQL_USER=

# Optional password for the analytics SPARQL endpoint.
# ANALYTICS_SPARQL_PASSWORD=

# Comma-separated origins permitted to call the analytics API.
ANALYTICS_ALLOWED_ORIGINS=http://localhost:3000

# Time-to-live in seconds for cached analytics query results.
ANALYTICS_RESULT_CACHE_TTL=300

# SPARQL timeout in seconds for analytics queries.
ANALYTICS_SPARQL_TIMEOUT=20

# Published port for the analytics API container.
ANALYTICS_API_PORT=8000

# ------------------------------------------------------------
# Analytics UI
# ------------------------------------------------------------

# Base URL the dashboard uses to reach the analytics API.
NEXT_PUBLIC_ANALYTICS_API_URL=http://localhost:8000

# Published port for the analytics UI container.
ANALYTICS_UI_PORT=3000

# ------------------------------------------------------------
# Virtuoso performance tuning
# ------------------------------------------------------------
# Raw Virtuoso configuration parameters passed through to
# virtuoso.ini (see
# https://docs.openlinksw.com/virtuoso/rdfperformancetuning/#rdfperfgeneral).
# These are optional; only tweak them if you know what they do.

# Total number of database buffers.
VIRT_PARAMETERS_NUMBEROFBUFFERS=340000

# Maximum number of dirty buffers before a checkpoint is triggered.
VIRT_PARAMETERS_MAXDIRTYBUFFERS=250000

# Interval in seconds between automatic checkpoints.
VIRT_PARAMETERS_CHECKPOINTINTERVAL=60

# Row batch size used when building the free-text index.
VIRT_PARAMETERS_FREETEXTBATCHSIZE=100000

# Number of worker threads serving the database.
VIRT_PARAMETERS_SERVERTHREADS=20

# Maximum checkpoint remap for the main database.
VIRT_DATABASE_MAXCHECKPOINTREMAP=16000

# Maximum checkpoint remap for the temporary database.
VIRT_TEMPDATABASE_MAXCHECKPOINTREMAP=16000

# Number of worker threads serving the HTTP endpoint.
VIRT_HTTPSERVER_SERVERTHREADS=10

# Stack size in bytes allocated to each HTTP worker thread.
VIRT_HTTPSERVER_HTTPTHREADSIZE=280000

# Directories Virtuoso may read for bulk loads (ld_dir).
# /database/data is where RDF files are mounted so it must stay in
# this list.
# /app/imports is the shared workbench volume (uploads and exports)
# and must stay in this list.
VIRT_PARAMETERS_DIRSALLOWED=., ../vad, /usr/share/proj, /database/data, /app/imports
