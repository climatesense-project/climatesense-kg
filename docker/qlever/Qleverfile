# QLever configuration for the ClimateSense knowledge graph.

[data]
NAME = climatesense
DESCRIPTION = ClimateSense climate misinformation knowledge graph

# Do not change this variable. It is automatically substituted by
# the deployment script (deploy-index.sh).
SNAPSHOT_DIRECTORY = __SNAPSHOT_DIRECTORY__

[index]
INPUT_FILES = ${data:SNAPSHOT_DIRECTORY}/*.nt.gz ../source/vocabularies/*.ttl ../source/organizations.ttl ../source/graphs.ttl

# Snapshot graph entries are generated by deploy-index.sh from the snapshot
# run directory. __SNAPSHOT_INPUT_JSON__ expands to one entry per .nt.gz
# artifact, each ending in a comma.
MULTI_INPUT_JSON = [__SNAPSHOT_INPUT_JSON__                    { "cmd": "cat {}", "format": "ttl", "graph": "http://data.climatesense-project.eu/graph/vocabularies", "for-each": "../source/vocabularies/*.ttl", "parallel": "false" },
                    { "cmd": "cat {}", "format": "ttl", "graph": "http://data.climatesense-project.eu/graph/organizations", "for-each": "../source/organizations.ttl", "parallel": "false" },
                    { "cmd": "cat {}", "format": "ttl", "graph": "http://data.climatesense-project.eu/graph/catalog", "for-each": "../source/graphs.ttl", "parallel": "false" }]

STXXL_MEMORY = 1G
VOCABULARY_TYPE = on-disk-compressed
TEXT_INDEX = from_literals
ADD_HAS_WORD_TRIPLES = true

[server]
HOST_NAME = 0.0.0.0
PORT = 7019
MEMORY_FOR_QUERIES = 5G
CACHE_MAX_SIZE = 2G
TIMEOUT = 30s
PERSIST_UPDATES = true

[runtime]
SYSTEM = native
