# QLever index template used by deploy-index.sh.
# The deployment script replaces the snapshot directory placeholder before indexing.

[data]
NAME = climatesense
DESCRIPTION = ClimateSense climate misinformation knowledge graph
SNAPSHOT_DIRECTORY = __SNAPSHOT_DIRECTORY__

[index]
INPUT_FILES = ${data:SNAPSHOT_DIRECTORY}/*.nt.gz ../source/vocabularies/*.ttl ../source/organizations.ttl ../source/graphs.ttl

MULTI_INPUT_JSON = [{ "cmd": "gunzip -c {}", "format": "nt", "graph": "http://data.climatesense-project.eu/graph/claimreviewdata", "for-each": "${data:SNAPSHOT_DIRECTORY}/claimreviewdata.nt.gz", "parallel": "true" },
                    { "cmd": "gunzip -c {}", "format": "nt", "graph": "http://data.climatesense-project.eu/graph/euroclimatecheck", "for-each": "${data:SNAPSHOT_DIRECTORY}/euroclimatecheck.nt.gz", "parallel": "true" },
                    { "cmd": "gunzip -c {}", "format": "nt", "graph": "http://data.climatesense-project.eu/graph/defacto", "for-each": "${data:SNAPSHOT_DIRECTORY}/defacto.nt.gz", "parallel": "true" },
                    { "cmd": "gunzip -c {}", "format": "nt", "graph": "http://data.climatesense-project.eu/graph/dbkf", "for-each": "${data:SNAPSHOT_DIRECTORY}/dbkf.nt.gz", "parallel": "true" },
                    { "cmd": "gunzip -c {}", "format": "nt", "graph": "http://data.climatesense-project.eu/graph/desmog", "for-each": "${data:SNAPSHOT_DIRECTORY}/desmog.nt.gz", "parallel": "true" },
                    { "cmd": "gunzip -c {}", "format": "nt", "graph": "http://data.climatesense-project.eu/graph/climafacts", "for-each": "${data:SNAPSHOT_DIRECTORY}/climafacts.nt.gz", "parallel": "true" },
                    { "cmd": "gunzip -c {}", "format": "nt", "graph": "http://data.climatesense-project.eu/graph/climate-fever", "for-each": "${data:SNAPSHOT_DIRECTORY}/climate-fever.nt.gz", "parallel": "true" },
                    { "cmd": "gunzip -c {}", "format": "nt", "graph": "http://data.climatesense-project.eu/graph/dbpedia-enricher", "for-each": "${data:SNAPSHOT_DIRECTORY}/dbpedia-enricher.nt.gz", "parallel": "true" },
                    { "cmd": "cat {}", "format": "ttl", "graph": "http://data.climatesense-project.eu/graph/vocabularies", "for-each": "../source/vocabularies/*.ttl", "parallel": "false" },
                    { "cmd": "cat {}", "format": "ttl", "graph": "http://data.climatesense-project.eu/graph/organizations", "for-each": "../source/organizations.ttl", "parallel": "false" },
                    { "cmd": "cat {}", "format": "ttl", "graph": "http://data.climatesense-project.eu/graph/catalog", "for-each": "../source/graphs.ttl", "parallel": "false" }]

STXXL_MEMORY = 1G
VOCABULARY_TYPE = on-disk-compressed

[server]
HOST_NAME = 0.0.0.0
PORT = 7019
MEMORY_FOR_QUERIES = 5G
CACHE_MAX_SIZE = 2G
TIMEOUT = 30s
PERSIST_UPDATES = true

[runtime]
SYSTEM = native
