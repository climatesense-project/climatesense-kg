# ============================================================
# ClimateSense KG - nightly deploy configuration
# ============================================================
# Copy this file to ops/deploy.env and adjust the values:
#
#   cp ops/deploy.env.example ops/deploy.env
#
# This file is not tracked by git and holds the deploy-specific
# settings for a given host.
# ============================================================

# ------------------------------------------------------------
# General
# ------------------------------------------------------------

# Absolute path to the ClimateSense KG checkout. When unset, the
# script defaults to the parent directory of ops/run-pipeline.sh.
PROJECT_DIR=

# Lock file used to prevent overlapping runs.
LOCK_FILE=/tmp/climatesense_deploy.lock

# Triplestore backend the pipeline deploys to and starts: "qlever"
# (default) or "virtuoso".
TRIPLESTORE=qlever

# Directory where nightly run logs are written. When unset,
# defaults to "$PROJECT_DIR/logs".
LOG_DIR=

# ------------------------------------------------------------
# Healthchecks
# ------------------------------------------------------------

# Base URL of the healthcheck ping endpoint. The script pings
# /start when the run begins and /<exit-code> when it finishes.
# Required.
HEALTHCHECK_BASE_URL=
